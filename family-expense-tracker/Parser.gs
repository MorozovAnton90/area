// ============================================================
// Parser.gs — парсинг сообщений пользователя
// ============================================================
// Примеры сообщений:
//   "1840 пятерочка"
//   "еда 3200 доставка"
//   "миро 950 книга"
//   "медицина 2500 линзы"
// ============================================================

// Список категорий и ключевых слов для автоопределения
var CATEGORIES = {
  "Еда": ["еда", "продукты", "пятерочка", "магнит", "перекресток", "вкусвилл", "лента", "ашан", "супермаркет", "кафе", "ресторан", "суши", "пицца", "фастфуд", "макдак", "бургер", "кофе", "чай", "напитки"],
  "Дом и быт": ["дом", "быт", "хозяйство", "чистота", "уборка", "порошок", "средство", "мыло", "посуда", "мебель", "икеа", "леруа", "ремонт", "инструмент"],
  "Мирон": ["миро", "мирон", "ребенок", "детское", "игрушка", "садик", "школа", "секция", "кружок"],
  "Одежда и обувь": ["одежда", "обувь", "платье", "штаны", "футболка", "кроссовки", "ботинки", "куртка", "пальто", "магазин одежды", "zara", "h&m"],
  "Обязательные платежи": ["аренда", "квартплата", "коммуналка", "интернет", "связь", "телефон", "страховка", "кредит", "ипотека", "налог"],
  "Транспорт": ["такси", "яндекс такси", "яндекс го", "убер", "метро", "автобус", "бензин", "заправка", "парковка", "каршеринг", "транспорт", "самокат"],
  "Красота и уход": ["красота", "уход", "салон", "маникюр", "педикюр", "стрижка", "парикмахер", "косметика", "шампунь", "крем"],
  "Медицина": ["медицина", "врач", "доктор", "аптека", "лекарство", "таблетки", "анализы", "клиника", "больница", "линзы", "очки"],
  "Подарки": ["подарок", "праздник", "день рождения", "цветы"],
  "Маркетплейсы / разное": ["озон", "ozon", "вайлдберриз", "wildberries", "маркетплейс", "алиэкспресс", "amazon", "яндекс маркет", "яндекс лавка", "яндекс еда"],
  "Непонятное": []
};

// Главная функция парсинга
function parseMessage(text) {
  var result = {
    amount: null,
    category: null,
    comment: "",
    raw: text
  };

  // Убираем лишние пробелы и приводим к нижнему регистру для анализа
  var normalized = text.trim();
  var lower = normalized.toLowerCase();

  // Находим все числа в сообщении
  var numbers = normalized.match(/\d+[\.,]?\d*/g);
  if (!numbers || numbers.length === 0) {
    return null; // Нет суммы — не расход
  }

  // Берём самое большое число как сумму (скорее всего это цена)
  var amount = 0;
  var amountStr = "";
  for (var i = 0; i < numbers.length; i++) {
    var num = parseFloat(numbers[i].replace(",", "."));
    if (num > amount) {
      amount = num;
      amountStr = numbers[i];
    }
  }
  result.amount = amount;

  // Убираем число из текста, остаток — это категория/комментарий
  var withoutAmount = normalized.replace(amountStr, "").trim();
  // Убираем двойные пробелы
  withoutAmount = withoutAmount.replace(/\s+/g, " ").trim();
  result.comment = withoutAmount;

  // Пытаемся определить категорию по ключевым словам
  result.category = detectCategory(lower);

  return result;
}

// Определение категории по ключевым словам
function detectCategory(text) {
  for (var category in CATEGORIES) {
    var keywords = CATEGORIES[category];
    for (var i = 0; i < keywords.length; i++) {
      if (text.indexOf(keywords[i]) !== -1) {
        return category;
      }
    }
  }
  return null; // Категория не определена
}

// Возвращает список всех категорий (для кнопок)
function getCategoryList() {
  return Object.keys(CATEGORIES);
}
